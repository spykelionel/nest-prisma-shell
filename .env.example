# Copy to .env for local development. Every variable is validated at boot
# (src/core/config/env.validation.ts); the process refuses to start with a
# list of everything that is wrong. Placeholders only — never commit secrets.

# --- shared (API and worker) -------------------------------------------
NODE_ENV=development
# Stamped on every log line. Set a distinct value per process in deployment
# (e.g. nestjs-base-api / nestjs-base-worker).
SERVICE_NAME=nestjs-base
# pino levels: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Human-readable logs via pino-pretty (devDependency). Local only: the
# production image does not contain pino-pretty, so leave this false there.
LOG_PRETTY=false

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
REDIS_KEY_PREFIX=nestjs-base:

# Must be identical for the API and the workers.
QUEUE_PREFIX=nestjs-base-bull
WORKER_CONCURRENCY=5

# S3-compatible storage. Local values match docker-compose's MinIO.
# AWS S3: leave STORAGE_ENDPOINT empty and set STORAGE_REGION.
# Cloudflare R2: STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, STORAGE_REGION=auto.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=nestjs-base-local
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_FORCE_PATH_STYLE=true
STORAGE_PRESIGN_TTL_SECONDS=900

# --- API only (workers never receive these) -----------------------------
PORT=3000
# Number of reverse proxies in front of the API (0 = exposed directly).
TRUST_PROXY_HOPS=0
# Comma-separated allowlist; empty = CORS disabled.
CORS_ORIGINS=http://localhost:5173
BODY_LIMIT=1mb
SWAGGER_ENABLED=true

# Prisma on MongoDB needs a replica set. directConnection lets the host
# machine reach the single-node set from docker-compose.
DATABASE_URL=mongodb://localhost:27017/nestjs_base?replicaSet=rs0&directConnection=true
DB_MAX_POOL_SIZE=20
DB_MIN_POOL_SIZE=2
DB_SERVER_SELECTION_TIMEOUT_MS=10000

# At least 32 characters. Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
JWT_EXPIRES_IN_SECONDS=900
JWT_ISSUER=
JWT_AUDIENCE=
